{# luci-theme-echo 2.0 — Sign-in page #}
{%
  import { readfile, access } from 'fs';
  import { cursor } from 'uci';

  const echo_version = trim(readfile('/usr/share/ucode/luci/template/themes/echo/version')) ?? '?';
  /* The sysauth scope has no ubus object; read the kernel hostname instead. */
  const hostname = striptags(trim(readfile('/proc/sys/kernel/hostname')) ?? 'OpenWrt');

  let echo_primary = '#0071e3';
  let echo_dark_primary = '#0a84ff';
  let echo_font_size = '16';
  let echo_preset = 'openwrt';

  let cfg = cursor();
  if (access('/etc/config/echo')) {
    echo_primary = cfg.get_first('echo', 'global', 'primary') ?? echo_primary;
    echo_dark_primary = cfg.get_first('echo', 'global', 'dark_primary') ?? echo_dark_primary;
    echo_font_size = cfg.get_first('echo', 'global', 'font_size') ?? echo_font_size;
    echo_preset = cfg.get_first('echo', 'global', 'preset') ?? echo_preset;
  }

  if (echo_preset == 'be88u')
    echo_preset = 'openwrt';

-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="auto">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#f5f5f7" id="meta-theme-color">
  <meta name="color-scheme" content="light dark">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <title>{{ _('Log in') }} - {{ hostname }}</title>
  <link rel="icon" href="{{ media }}/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ media }}/img/favicon.svg">
  <script>
  (function () {
    var THEME_KEY = 'echo-theme';
    var mode = 'auto';
    try { mode = localStorage.getItem(THEME_KEY) || 'auto'; } catch (e) {}
    if (['auto', 'light', 'dark'].indexOf(mode) < 0) mode = 'auto';

    var root = document.documentElement;
    root.dataset.theme = mode;

    var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    var isDark = mode === 'dark' || (mode === 'auto' && systemDark);
    root.setAttribute('data-darkmode', isDark ? 'true' : 'false');

    var meta = document.getElementById('meta-theme-color');
    if (meta) meta.setAttribute('content', isDark ? '#000000' : '#f5f5f7');
  })();
  </script>
  <link rel="stylesheet" href="{{ media }}/css/echo.css">
  <style id="echo-config">
    html { font-size: {{ echo_font_size }}px; }
    :root {
      --echo-accent: {{ echo_primary }};
      --echo-accent-hover: {{ echo_primary }};
      --echo-primary: {{ echo_primary }};
      --echo-primary-hover: {{ echo_primary }};
    }
    html[data-theme="dark"] {
      --echo-accent: {{ echo_dark_primary }};
      --echo-accent-hover: {{ echo_dark_primary }};
      --echo-primary: {{ echo_dark_primary }};
      --echo-primary-hover: {{ echo_dark_primary }};
    }
    @media (prefers-color-scheme: dark) {
      html:not([data-theme="light"]) {
        --echo-accent: {{ echo_dark_primary }};
        --echo-accent-hover: {{ echo_dark_primary }};
        --echo-primary: {{ echo_dark_primary }};
        --echo-primary-hover: {{ echo_dark_primary }};
      }
    }
  </style>
</head>
<body class="echo-login theme-openwrt">

<div class="login-theme">
  <div class="theme-switch" role="group" aria-label="{{ _('Appearance') }}">
    <button type="button" data-theme-mode="auto" aria-pressed="true" aria-label="{{ _('Theme: Auto (System)') }}" title="{{ _('Theme: Auto (System)') }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"/></svg>
    </button>
    <button type="button" data-theme-mode="light" aria-pressed="false" aria-label="{{ _('Theme: Light') }}" title="{{ _('Theme: Light') }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
    </button>
    <button type="button" data-theme-mode="dark" aria-pressed="false" aria-label="{{ _('Theme: Dark') }}" title="{{ _('Theme: Dark') }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.5 8.5 0 1 0 10.4 10.4Z"/></svg>
    </button>
  </div>
</div>

<main class="echo-login-card">
  {% if (fuser): %}
  <div class="echo-login-error" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>
  {% endif %}

  <div class="echo-login-brand">
    <img class="echo-login-mark" src="{{ media }}/img/echo-mark.svg" alt="" width="58" height="58">
    <h1 class="echo-login-hostname">{{ hostname }}</h1>
    <p class="echo-login-subtitle">{{ _('Sign in to manage your router') }}</p>
  </div>

  <form method="post" class="echo-login-form">
    <div class="cbi-value">
      <label class="cbi-value-title" for="luci_username">{{ _('Username') }}</label>
      <div class="cbi-value-field">
        <input class="cbi-input-text" type="text" name="luci_username" id="luci_username" value="root" autocomplete="username" autocapitalize="none" spellcheck="false" required>
      </div>
    </div>

    <div class="cbi-value">
      <label class="cbi-value-title" for="luci_password">{{ _('Password') }}</label>
      <div class="cbi-value-field">
        <div class="echo-password-wrap">
          <input class="cbi-input-password" type="password" name="luci_password" id="luci_password" autocomplete="current-password" required>
          <button type="button" class="echo-password-toggle" id="echo-password-toggle" aria-label="{{ _('Show password') }}" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3.1"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="cbi-page-actions">
      <button class="cbi-button cbi-button-apply" type="submit">{{ _('Log in') }}</button>
    </div>
  </form>

  <div class="echo-login-footer">
    <div class="echo-login-hint">
      <span class="echo-symbol echo-symbol-shield" aria-hidden="true"></span>
      <span>{{ _('Secured by OpenWrt') }}</span>
    </div>
    <div style="margin-top:8px">
      <a class="footer-link" href="https://openwrt.org" target="_blank" rel="noopener noreferrer">OpenWrt</a>
      <span class="footer-dot" aria-hidden="true" style="display:inline-block;margin:0 6px;vertical-align:middle"></span>
      <a class="footer-link" href="https://github.com/Jas0n0ss/openwrt-theme-echo" target="_blank" rel="noopener noreferrer">Echo {{ echo_version }}</a>
    </div>
  </div>
</main>

<script>
(function () {
  var THEME_KEY = 'echo-theme';
  var MODES = ['auto', 'light', 'dark'];

  function systemDark() {
    return !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
  }

  function applyTheme(mode) {
    if (MODES.indexOf(mode) < 0) mode = 'auto';
    var dark = mode === 'dark' || (mode === 'auto' && systemDark());
    document.documentElement.dataset.theme = mode;
    document.documentElement.setAttribute('data-darkmode', dark ? 'true' : 'false');
    var meta = document.getElementById('meta-theme-color');
    if (meta) meta.setAttribute('content', dark ? '#000000' : '#f5f5f7');
    document.querySelectorAll('[data-theme-mode]').forEach(function (btn) {
      btn.setAttribute('aria-pressed', btn.getAttribute('data-theme-mode') === mode ? 'true' : 'false');
    });
  }

  var initialMode = 'auto';
  try { initialMode = localStorage.getItem(THEME_KEY) || 'auto'; } catch (e) {}
  applyTheme(initialMode);

  document.querySelectorAll('[data-theme-mode]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var mode = btn.getAttribute('data-theme-mode');
      try { localStorage.setItem(THEME_KEY, mode); } catch (e) {}
      applyTheme(mode);
    });
  });

  if (window.matchMedia) {
    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    var onChange = function () {
      var mode = 'auto';
      try { mode = localStorage.getItem(THEME_KEY) || 'auto'; } catch (e) {}
      if (mode === 'auto') applyTheme('auto');
    };
    if (mq.addEventListener) mq.addEventListener('change', onChange);
    else if (mq.addListener) mq.addListener(onChange);
  }

  var pw = document.getElementById('luci_password');
  var toggle = document.getElementById('echo-password-toggle');

  if (pw && toggle) {
    toggle.addEventListener('click', function () {
      var show = pw.type === 'password';
      pw.type = show ? 'text' : 'password';
      toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
      toggle.setAttribute('aria-label', show ? '{{ _('Hide password') }}' : '{{ _('Show password') }}');
      pw.focus();
    });
  }

  if (pw) pw.focus();
})();
</script>
</body>
</html>
