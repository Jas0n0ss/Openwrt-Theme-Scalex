{#
  luci-theme-scalex 2.1 — Main document header
  Apple-inspired shell for OpenWrt / LuCI.
-#}

{%
  import { access } from 'fs';
  import { cursor } from 'uci';
  import { getuid, getspnam } from 'luci.core';

  const boardinfo = ubus.call('system', 'board');
  const hostname = striptags(boardinfo?.hostname ?? 'OpenWrt');

  let scalex_primary = '#0071e3';
  let scalex_dark_primary = '#0a84ff';
  let scalex_bg_mode = 'gradient';
  let scalex_font_size = '16';
  let scalex_bg_src = null;
  let scalex_preset = 'openwrt';

  let cfg = cursor();
  if (access('/etc/config/scalex')) {
    scalex_primary = cfg.get_first('scalex', 'global', 'primary') ?? scalex_primary;
    scalex_dark_primary = cfg.get_first('scalex', 'global', 'dark_primary') ?? scalex_dark_primary;
    scalex_bg_mode = cfg.get_first('scalex', 'global', 'background_mode') ?? scalex_bg_mode;
    scalex_font_size = cfg.get_first('scalex', 'global', 'font_size') ?? scalex_font_size;
    scalex_preset = cfg.get_first('scalex', 'global', 'preset') ?? scalex_preset;
  }

  if (scalex_preset == 'be88u')
    scalex_preset = 'openwrt';

  const bg_dir = '/www/luci-static/scalex/background';
  const img_exts = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];
  if (scalex_bg_mode == 'custom') {
    for (let ext in img_exts) {
      if (access(bg_dir + '/bg' + ext)) {
        scalex_bg_src = media + '/background/bg' + ext;
        break;
      }
    }
  }

  http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="auto">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#f5f5f7" id="meta-theme-color">
  <meta name="color-scheme" content="light dark">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <title>{{ hostname }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - LuCI</title>
  <link rel="icon" href="{{ media }}/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ media }}/img/favicon.svg">
  <script>
  (function () {
    var THEME_KEY = 'scalex-theme';
    var mode = 'auto';
    try { mode = localStorage.getItem(THEME_KEY) || 'auto'; } catch (e) {}
    if (['auto', 'light', 'dark'].indexOf(mode) < 0) mode = 'auto';

    var root = document.documentElement;
    root.dataset.theme = mode;

    var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    var isDark = mode === 'dark' || (mode === 'auto' && systemDark);
    root.setAttribute('data-darkmode', isDark ? 'true' : 'false');

    var meta = document.getElementById('meta-theme-color');
    if (meta) meta.setAttribute('content', isDark ? '#000000' : '#f5f5f7');
  })();
  </script>
  <link rel="stylesheet" href="/luci-static/bootstrap/cascade.css" data-scalex-base="bootstrap">
  <link rel="stylesheet" href="{{ media }}/css/scalex.css">
  <style id="scalex-config">
    html { font-size: {{ scalex_font_size }}px; }
    :root {
      --scalex-accent: {{ scalex_primary }};
      --scalex-accent-hover: {{ scalex_primary }};
      --scalex-primary: {{ scalex_primary }};
      --scalex-primary-hover: {{ scalex_primary }};
    }
    html[data-theme="dark"] {
      --scalex-accent: {{ scalex_dark_primary }};
      --scalex-accent-hover: {{ scalex_dark_primary }};
      --scalex-primary: {{ scalex_dark_primary }};
      --scalex-primary-hover: {{ scalex_dark_primary }};
    }
    @media (prefers-color-scheme: dark) {
      html:not([data-theme="light"]) {
        --scalex-accent: {{ scalex_dark_primary }};
        --scalex-accent-hover: {{ scalex_dark_primary }};
        --scalex-primary: {{ scalex_dark_primary }};
        --scalex-primary-hover: {{ scalex_dark_primary }};
      }
    }
    {% if (scalex_bg_src): %}
    body.has-custom-bg {
      background-image:
        linear-gradient(rgba(245, 245, 247, 0.82), rgba(245, 245, 247, 0.82)),
        url('{{ scalex_bg_src }}');
      background-position: center;
      background-size: cover;
      background-attachment: fixed;
    }
    html[data-theme="dark"] body.has-custom-bg {
      background-image:
        linear-gradient(rgba(0, 0, 0, 0.76), rgba(0, 0, 0, 0.76)),
        url('{{ scalex_bg_src }}');
    }
    @media (prefers-color-scheme: dark) {
      html:not([data-theme="light"]) body.has-custom-bg {
        background-image:
          linear-gradient(rgba(0, 0, 0, 0.76), rgba(0, 0, 0, 0.76)),
          url('{{ scalex_bg_src }}');
      }
    }
    {% endif %}
  </style>
  <script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
  <script src="{{ resource }}/cbi.js?v={{ version.luciversion }}"></script>
  {% if (node?.css): %}
  <link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
  {% endif %}
  {% if (css): %}
  <style title="text/css">{{ css }}</style>
  {% endif %}
</head>
<body class="theme-openwrt{% if (scalex_preset == 'openwrt'): %} preset-openwrt{% endif %}{% if (scalex_bg_src): %} has-custom-bg{% elif (scalex_bg_mode == 'none'): %} bg-none{% endif %}">

<a class="scalex-skip-link" href="#maincontent">{{ _('Skip to content') }}</a>

<div id="scalex-app">
  <div id="scalex-main">
    <header id="scalex-nav-bar">
      <div class="nav-bar-container">
        <div class="nav-bar-row">
          <a class="header-brand" href="{{ dispatcher.build_url('admin/status/overview') }}" aria-label="{{ _('ScaleX home') }}">
            <img class="scalex-mark" src="{{ media }}/img/scalex-mark.svg" alt="" width="28" height="28">
            <span class="brand-name">ScaleX</span>
            <span class="brand-divider" aria-hidden="true"></span>
            <span class="brand-host">{{ hostname }}</span>
          </a>

          <div class="top-nav-shell">
            <div class="top-nav-wrap">
              <nav id="top-nav" class="scalex-top-nav" aria-label="{{ _('Main navigation') }}"></nav>
              <div class="top-nav-more" id="top-nav-more" hidden>
                <button type="button" class="top-nav-more-btn" id="top-nav-more-btn" aria-expanded="false" aria-haspopup="true">
                  <span class="nav-label">{{ _('More') }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="top-nav-more-menu" id="top-nav-more-menu" hidden></div>
              </div>
            </div>
          </div>

          <div class="header-actions">
            <div class="theme-switch" role="group" aria-label="{{ _('Appearance') }}">
              <button type="button" data-theme-mode="auto" aria-pressed="true" aria-label="{{ _('Theme: Auto (System)') }}" title="{{ _('Theme: Auto (System)') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"/></svg>
              </button>
              <button type="button" data-theme-mode="light" aria-pressed="false" aria-label="{{ _('Theme: Light') }}" title="{{ _('Theme: Light') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
              </button>
              <button type="button" data-theme-mode="dark" aria-pressed="false" aria-label="{{ _('Theme: Dark') }}" title="{{ _('Theme: Dark') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.5 8.5 0 1 0 10.4 10.4Z"/></svg>
              </button>
            </div>

            <button type="button" class="icon-btn" id="scalex-menu-btn" aria-label="{{ _('Open menu') }}" aria-expanded="false" aria-controls="scalex-sheet">
              <span class="scalex-symbol scalex-symbol-menu" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </div>

      <div class="scalex-bootstrap-hooks" hidden aria-hidden="true">
        <ul id="modemenu" class="nav"></ul>
        <ul id="topmenu"></ul>
      </div>
    </header>

    <header id="scalex-header">
      <div class="header-toolbar">
        <div class="header-titles">
          <div id="header-breadcrumb" class="header-breadcrumb"></div>
          <h1 id="header-title"></h1>
        </div>
      </div>
    </header>

    <div id="scalex-content-wrap">
      <div class="content-tabs-container">
        <nav id="content-tabs" class="tabs" aria-label="{{ _('Section tabs') }}"></nav>
        <div id="tabmenu" class="tabs scalex-tabmenu-hook" hidden aria-hidden="true"></div>
      </div>

{% if (!blank_page): %}
      <main id="maincontent" tabindex="-1">

      {% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
      <div class="alert-message warning">
        <strong>{{ _('No password set!') }}</strong>
        {{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}
        {% if (dispatcher.lookup("admin/system/admin")): %}
        <a href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Go to password configuration...') }}</a>
        {% endif %}
      </div>
      {% endif %}

      {% if (boardinfo.rootfs_type == "initramfs"): %}
      <div class="alert-message warning">
        <strong>{{ _('System running in recovery (initramfs) mode.') }}</strong>
        {{ _('No changes to settings will be stored and are lost after rebooting.') }}
        {% if (dispatcher.lookup("admin/system/flash")): %}
        <a href="{{ dispatcher.build_url('admin/system/flash') }}">{{ _('Go to firmware upgrade...') }}</a>
        {% endif %}
      </div>
      {% endif %}

      <noscript>
        <div class="alert-message warning">
          <strong>{{ _('JavaScript required!') }}</strong>
          {{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}
        </div>
      </noscript>
{% endif %}
